- name: epy_block_0
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nPersistent GEOSCAN image chunk accumulator for 239Alferov.\nMerges chunks across ALL runs/passes (state persisted to disk after every\nnew chunk) until each image (by fnum) is fully reconstructed, mirroring\nSatsDecoder's \"merge mode\".\n\"\"\"\n\nimport json\nimport pathlib\nimport struct\n\nimport pmt\nfrom gnuradio import gr\n\nMARKER_V2_IMG = 0x6F6B6F31\nALFEROV239 = 0x09\n\n\nclass blk(gr.basic_block):\n    def __init__(self, state_file='~/alferov_state.json', out_dir='~/alferov_images'):\n        gr.basic_block.__init__(self, name='geoscan_image_accumulator',\n                                 in_sig=[], out_sig=[])\n        self.state_file = pathlib.Path(state_file).expanduser()\n        self.out_dir = pathlib.Path(out_dir).expanduser()\n\n        # Create any missing parent folders up front, not just the leaf dir,\n        # so pointing these at a brand-new nested path doesn't crash later.\n        self.state_file.parent.mkdir(parents=True, exist_ok=True)\n\
      \        self.out_dir.mkdir(parents=True, exist_ok=True)\n\n        print(f'[accumulator] state file : {self.state_file.resolve()}')\n        print(f'[accumulator] output dir : {self.out_dir.resolve()}')\n\n        self.state = self._load_state()\n        total = sum(len(c) for c in self.state.values())\n        print(f'[accumulator] loaded {len(self.state)} image(s), '\n              f'{total} chunk(s) total')\n        self.message_port_register_in(pmt.intern('in'))\n        self.set_msg_handler(pmt.intern('in'), self.handle_msg)\n\n    def _load_state(self):\n        if self.state_file.exists():\n            raw = json.loads(self.state_file.read_text())\n            return {\n                int(fnum): {int(off): bytes.fromhex(data)\n                            for off, data in chunks.items()}\n                for fnum, chunks in raw.items()\n            }\n        return {}\n\n    def _save_state(self):\n        raw = {\n            str(fnum): {str(off): data.hex() for off, data\
      \ in chunks.items()}\n            for fnum, chunks in self.state.items()\n        }\n        tmp = self.state_file.with_suffix('.json.tmp')\n        tmp.write_text(json.dumps(raw))\n        tmp.replace(self.state_file)\n\n    @staticmethod\n    def _try_reconstruct(chunks):\n        if not chunks:\n            return None\n        max_off = max(chunks.keys())\n        buf = bytearray(max_off + 54)\n        for off, payload in chunks.items():\n            buf[off:off + 54] = payload\n        data = bytes(buf)\n        if not data.startswith(b'\\xff\\xd8'):\n            return None\n        eoi = data.find(b'\\xff\\xd9')\n        if eoi == -1:\n            return None\n        expected = set(range(0, max_off + 54, 54))\n        missing = sorted(expected - set(chunks.keys()))\n        return data[:eoi + 2], missing\n\n    def handle_msg(self, msg):\n        try:\n            data = bytes(pmt.u8vector_elements(pmt.cdr(msg)))\n        except Exception:\n            return\n        if len(data)\
      \ != 72 or data[0] != ALFEROV239:\n            return\n        marker = struct.unpack_from('<I', data, 5)[0]\n        if marker != MARKER_V2_IMG:\n            return\n\n        offset = struct.unpack_from('<I', data, 9)[0]\n        fnum = struct.unpack_from('<H', data, 13)[0]\n        payload = data[15:15 + 54]\n\n        chunks = self.state.setdefault(fnum, {})\n        is_new = offset not in chunks\n        chunks[offset] = payload\n\n        if is_new:\n            self._save_state()\n            print(f'[+] fnum={fnum} offset={offset} '\n                  f'({len(chunks)} chunks accumulated)')\n            result = self._try_reconstruct(chunks)\n            if result:\n                jpg, missing = result\n                out_path = self.out_dir / f'239alferov_fnum{fnum}.jpg'\n                out_path.write_bytes(jpg)\n                if missing:\n                    print(f'    -> updated {out_path.resolve()}, '\n                          f'still missing {missing}')\n       \
      \         else:\n                    print(f'    -> COMPLETE! wrote {out_path.resolve()}')\n"
    affinity: ''
    alias: ''
    comment: Persistent chunk accumulator -- state_file and out_dir below control where progress is saved. Safe to stop/restart any time.
    maxoutbuf: '0'
    minoutbuf: '0'
    out_dir: '"/home/bob/Desktop/alferov_data/images"'
    state_file: '"/home/bob/Desktop/alferov_data/alferov_state.json"'
  states:
    _io_cache: ('geoscan_image_accumulator', 'blk', [('state_file', "'~/alferov_state.json'"), ('out_dir', "'~/alferov_images'")], [('in', 'message', 1)], [], '', ['out_dir', 'state_file'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 952
    - 456.0
    rotation: 0
    state: enabled
